{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "jev",
  "agents": {
    "architect": {
      "model": "opencode-go/claude-haiku-5-5"
    },
    "planner": {
      "model": "opencode-go/claude-haiku-5-5"
    },
    "code-reviewer": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "security-auditor": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "python-reviewer": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "typescript-reviewer": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "database-reviewer": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "code-skeptic": {
      "model": "opencode-go/gemini-4-argon-contributor"
    },
    "web-performance-auditor": {
      "model": "opencode-go/qwen3.8-flash"
    },
    "test-engineer": {
      "model": "opencode-go/qwen3.8-flash"
    },
    "tdd-guide": {
      "model": "opencode-go/qwen3.8-flash"
    },
    "refactor-cleaner": {
      "model": "opencode-go/qwen3.8-flash"
    },
    "code-simplifier": {
      "model": "opencode-go/qwen3.8-flash"
    },
    "solo-code-engineer": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "jev": {
      "model": "openrouter/jev-router"
    }
  },
  "permission": {
    "edit": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "python .github/scripts/security_scan.py *": "allow",
      "python .github/scripts/checklist.py *": "allow",
      "python tools/antigravity_delegate.py *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "ask",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "rm -rf *": "deny",
      "del /s /q *": "deny",
      "DROP TABLE*": "deny",
      "DROP DATABASE*": "deny"
    },
    "skill": {
      "*": "allow",
      "ci-cd-and-automation": "ask",
      "permission-guard": "ask",
      "plan": "ask",
      "planning-and-task-breakdown": "ask",
      "requesting-code-review": "ask",
      "shipping-and-launch": "ask",
      "spec-driven-development": "ask",
      "subagent-driven-development": "ask",
      "task-delegation": "ask",
      "wayfinder": "ask"
    }
  }
}
