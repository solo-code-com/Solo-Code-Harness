{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "freemodel": {
      "name": "FreeModel",
      "env": [
        "FREEMODEL_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "${OPENAI_BASE_URL}/v1"
      },
      "models": {
        "gpt-6-sol": {
          "modelID": "gpt-6-sol",
          "name": "GPT-6 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "modelID": "gpt-6-astra",
          "name": "GPT-6 Astra",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-6.1-sol": {
          "modelID": "gpt-6.1-sol",
          "name": "GPT-6.1 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        }
      }
    },
    "deepseek": {
      "name": "DeepSeek (official)",
      "env": [
        "DEEPSEEK_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "${DEEPSEEK_BASE_URL}"
      },
      "models": {
        "deepseek-flash": {
          "modelID": "deepseek-flash",
          "name": "DeepSeek V4.1 Flash (official)",
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        },
        "deepseek-v4-pro": {
          "modelID": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro (official)",
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        }
      }
    },
    "openrouter": {
      "name": "OpenRouter",
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "modelID": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash (OpenRouter)",
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "deepseek-v4-pro": {
          "modelID": "deepseek/deepseek-v4-pro",
          "name": "DeepSeek V4 Pro (OpenRouter)",
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "deepseek-v4-flash": {
          "modelID": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash (OpenRouter)",
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "deepseek-v4-flash-vision-exp": {
          "modelID": "deepseek/deepseek-v4-flash-vision-exp",
          "name": "DeepSeek V4 Flash Vision Exp (OpenRouter)",
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "jev-router": {
          "modelID": "typesafe/jev-router",
          "name": "Jev Router (TypeSafe)",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    }
  }
}
