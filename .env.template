# Solo-Code environment template
# Copy to .env and fill in your keys. .env is gitignored.
#
# DeepSeek — direct API access to DeepSeek models
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# OpenRouter — extra route to DeepSeek models (and 400+ others)
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Command Code — gateway for frontier and open models
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_API_KEY=your-commandcode-key-here

# Silk Compute — uncensored / abliterated models
SILK_API_KEY=sk-your-silk-key-here

# FreeModel — Claude + ChatGPT on the free plan ($20/5h, $132/week; unused resets).
# Fill FREEMODEL_API, then run: python tools/free_arm.py setup  (or use tools/free_*.ps1 | .sh)
FREEMODEL_API=fe_oa-your-freemodel-key-here
FREEMODE_BASE_URL_Anthropic=https://cc.freemodel.dev
FREEMODE_BASE_URL_OPENAI=https://api.freemodel.dev
