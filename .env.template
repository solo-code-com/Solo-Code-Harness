# Solo-Code environment template
# Copy to .env and fill in your keys. .env is gitignored.
#
# DeepSeek — direct API access to DeepSeek models
# Get key at https://platform.deepseek.com
#
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
#
# OpenRouter — extra route to DeepSeek models (and 400+ others)
# Get key at https://openrouter.ai/keys
# The endpoint is the public constant _OPENROUTER_BASE_URL in tools/opencode_engine.py.
#
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
#
# --- OpenCode Go -------------------------------------------------------------
# opencode-go/... models resolve through OpenCode's own global config
# (~/.config/opencode/opencode.json); no key belongs in this file.
#
# ─── Claude Code via FreeModel (Anthropic-compatible gateway) ───────────────
# Launch with: ./claude-env.ps1   (default profile: gateway)
# Other profiles: ./claude-env.ps1 --profile native | --profile kilo
#
# Uncomment the tier your API key belongs to (Claude Code appends /v1/messages).
# All profiles run full mode by default; pass --bare explicitly to reduce it.
#   Standard : https://cc.freemodel.dev
#   Mid-tier : https://api-cc.freemodel.dev
#   Top-tier : https://cc-t2.freemodel.dev
#
ANTHROPIC_API_KEY=your-freemodel-key-here
ANTHROPIC_BASE_URL=https://cc.freemodel.dev
# ANTHROPIC_BASE_URL=https://api-cc.freemodel.dev
# ANTHROPIC_BASE_URL=https://cc-t2.freemodel.dev
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
#
# ─── Command Code Provider API ──────────────────────────────────────────────
# Gateway for frontier and open models (DeepSeek, Claude, GPT, Jev)
# Get key at https://commandcode.ai
# Base URL defaults to https://api.commandcode.ai/provider/v1
#
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_API_KEY=your-commandcode-key-here

